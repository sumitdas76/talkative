<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) manifest for Talkative. scripts\build_msix.ps1
  fills the {{...}} values; the identity ones come from Partner Center
  (Product identity page) and must match it exactly or the Store rejects
  the upload.

  - runFullTrust: Talkative is a normal desktop app (global hotkey hook,
    typing into other apps, UI Automation); it can't run in an app
    container.
  - microphone: dictation. Shows Talkative in Windows' microphone privacy
    list.
  - internetClient: Cloud mode, model downloads, update checks for models.
  - StartupTask "TalkativeStartup": start with Windows (talkative/autostart.py
    uses this id). Off until the user turns it on, like the GitHub version.
  - VCLibs: the Visual C++ runtime the speech engine needs; the Store
    installs it with the app (the GitHub installer runs vc_redist instead).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.30704.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Talkative" Executable="Talkative.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="{{DISPLAY_NAME}}"
                          Description="Hold a key, speak, and clean text is typed into any app."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Talkative.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TalkativeStartup" Enabled="false" DisplayName="{{DISPLAY_NAME}}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
